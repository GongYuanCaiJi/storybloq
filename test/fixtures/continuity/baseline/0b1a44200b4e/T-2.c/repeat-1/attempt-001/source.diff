diff --git a/src/jobs/JobQueue.test.ts b/src/jobs/JobQueue.test.ts
new file mode 100644
index 0000000..a462f88
--- /dev/null
+++ b/src/jobs/JobQueue.test.ts
@@ -0,0 +1,278 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { JobQueue, type QueuedJob } from "./JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("a failing job is logged under the request id that enqueued it", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: { n: 1 } }, { requestId: "req-a" });
+
+  const result = await queue.run(() => {
+    throw new Error("renderer exploded");
+  });
+
+  assert.deepEqual(result, { ran: 0, failed: 1 });
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].level, "error");
+  assert.equal(lines[0].requestId, "req-a");
+  assert.equal(lines[0].message, "job failed");
+  assert.deepEqual(lines[0].fields, { jobId: "job-1", kind: "report", error: "Error: renderer exploded" });
+});
+
+test("each failure carries its own originating request id, never a fresh one", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+  queue.enqueue({ kind: "export", payload: null }, { requestId: "req-b" });
+
+  await queue.run((job: QueuedJob) => {
+    throw new Error(`no handler for ${job.kind}`);
+  });
+
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.fields.kind]),
+    [
+      ["req-a", "report"],
+      ["req-b", "export"],
+    ],
+  );
+});
+
+test("a failure is logged and dropped; the jobs after it still run", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "bad", payload: null }, { requestId: "req-a" });
+  queue.enqueue({ kind: "good", payload: null }, { requestId: "req-b" });
+
+  const seen: string[] = [];
+  const result = await queue.run((job) => {
+    if (job.kind === "bad") throw new Error("boom");
+    seen.push(job.kind);
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  assert.deepEqual(seen, ["good"]);
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].requestId, "req-a");
+});
+
+test("a non-Error throw is still traceable, whatever shape it has", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  for (const kind of ["string", "object", "nullish", "exotic", "nested"]) {
+    queue.enqueue({ kind, payload: null }, { requestId: `req-${kind}` });
+  }
+
+  const result = await queue.run((job) => {
+    if (job.kind === "string") throw "just a string";
+    if (job.kind === "object") throw { message: "detailed failure", code: 42, token: "sk-abcdefghijk" };
+    if (job.kind === "nullish") throw undefined;
+    if (job.kind === "exotic") throw Object.create(null); // no prototype: String() on this throws
+    throw { cause: new Error("upstream died"), attempts: 2 };
+  });
+
+  assert.deepEqual(result, { ran: 0, failed: 5 });
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.fields.error]),
+    [
+      ["req-string", "just a string"],
+      // Normalised to plain data, so redact() still reaches the secret key inside it.
+      ["req-object", { message: "detailed failure", code: 42, token: "[REDACTED]" }],
+      ["req-nullish", "[undefined]"],
+      ["req-exotic", {}],
+      // A nested Error keeps its message, which is non-enumerable and would otherwise vanish.
+      ["req-nested", { cause: "Error: upstream died", attempts: 2 }],
+    ],
+  );
+});
+
+test("a thrown value cannot smuggle a secret past redaction into the written line", async () => {
+  // The sink a real deployment has: one that serialises. `toJSON` on a thrown object would otherwise run
+  // AFTER redact() and write back exactly what redaction removed.
+  const written: string[] = [];
+  const queue = new JobQueue((l) => written.push(JSON.stringify(l)));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+
+  await queue.run(() => {
+    throw {
+      toJSON() {
+        return { token: "sk-abcdefghijklmnop", auth: "Bearer supersecret" };
+      },
+    };
+  });
+
+  assert.equal(written.length, 1);
+  assert.ok(!written[0].includes("sk-abcdefghijklmnop"), `secret reached the written line: ${written[0]}`);
+  assert.ok(!written[0].includes("supersecret"), `secret reached the written line: ${written[0]}`);
+  assert.ok(written[0].includes('"requestId":"req-a"'));
+});
+
+test("a thrown value that resists inspection still produces a line under its request id", async () => {
+  const written: string[] = [];
+  const queue = new JobQueue((l) => written.push(JSON.stringify(l)));
+  const circular: Record<string, unknown> = {};
+  circular.self = circular;
+  const deep = { a: { b: { c: { d: { e: "too far down" } } } } };
+  const thrown: Record<string, unknown> = { circular, deep, big: 10n, sym: Symbol("oops") };
+  Object.defineProperty(thrown, "boom", {
+    enumerable: true,
+    get() {
+      throw new Error("getter exploded");
+    },
+  });
+
+  for (const kind of ["hostile", "symbol"]) queue.enqueue({ kind, payload: null }, { requestId: `req-${kind}` });
+  const result = await queue.run((job) => {
+    throw job.kind === "hostile" ? thrown : Symbol("just a symbol");
+  });
+
+  // Every one of these used to take the line down (or the whole drain with it).
+  assert.deepEqual(result, { ran: 0, failed: 2 });
+  assert.equal(written.length, 2, "a failure that cannot be described is still a failure worth logging");
+  const hostile = JSON.parse(written[0]) as LogLine;
+  assert.equal(hostile.requestId, "req-hostile");
+  assert.deepEqual(hostile.fields.error, {
+    circular: { self: "[seen]" },
+    deep: { a: { b: { c: "[truncated]" } } },
+    big: "10n",
+    sym: "Symbol(oops)",
+    boom: "[unreadable]",
+  });
+  assert.equal((JSON.parse(written[1]) as LogLine).fields.error, "Symbol(just a symbol)");
+});
+
+test("a sink that throws does not abort the drain", async () => {
+  const queue = new JobQueue(() => {
+    throw new Error("sink down");
+  });
+  queue.enqueue({ kind: "bad", payload: null }, { requestId: "req-a" });
+  queue.enqueue({ kind: "good", payload: null }, { requestId: "req-b" });
+
+  const seen: string[] = [];
+  const result = await queue.run((job) => {
+    if (job.kind === "bad") throw new Error("boom");
+    seen.push(job.kind);
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  assert.deepEqual(seen, ["good"], "the job after the unloggable failure still ran");
+  assert.equal(queue.size, 0);
+});
+
+test("a secret inside a job's error message is redacted before it is written", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+
+  await queue.run(() => {
+    throw new Error("upstream refused Bearer abc");
+  });
+
+  assert.equal(lines[0].fields.error, "Error: upstream refused [REDACTED]");
+});
+
+test("a job that succeeds logs nothing", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+
+  const result = await queue.run(() => {});
+
+  assert.deepEqual(result, { ran: 1, failed: 0 });
+  assert.deepEqual(lines, []);
+});
+
+test("enqueue refuses a job with no usable request id, and a refusal costs nothing", () => {
+  const queue = new JobQueue();
+  const job = { kind: "report", payload: null };
+  assert.throws(() => queue.enqueue(job, { requestId: "" }), /non-empty request id/);
+  assert.throws(() => queue.enqueue(job, { requestId: "  " }), /non-empty request id/);
+  // Types say string, but the guard is the last line of defence for a JS caller that ignores them.
+  assert.throws(() => queue.enqueue(job, { requestId: undefined as unknown as string }), /non-empty request id/);
+  assert.equal(queue.size, 0);
+  assert.equal(queue.enqueue(job, { requestId: "req-a" }), "job-1", "a refused enqueue does not burn a job id");
+});
+
+test("a value that cannot be described at all still produces exactly one line", async () => {
+  const written: LogLine[] = [];
+  const queue = new JobQueue((l) => written.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+
+  await queue.run(() => {
+    // Hostile enough to defeat inspection itself: the prototype check that runs before any guard throws.
+    throw new Proxy(
+      {},
+      {
+        getPrototypeOf() {
+          throw new Error("no introspection for you");
+        },
+      },
+    );
+  });
+
+  assert.deepEqual(
+    written.map((l) => [l.requestId, l.fields.error]),
+    [["req-a", "[unloggable thrown value]"]],
+    "one line, never two: a second emit would contradict the first",
+  );
+});
+
+test("a secret cannot reach the written line by hiding in a key, a wrapper, or a byte buffer", async () => {
+  const written: string[] = [];
+  const queue = new JobQueue((l) => written.push(JSON.stringify(l)));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+
+  await queue.run(() => {
+    throw {
+      // Key position: redaction tested key names but only ever replaced values.
+      ["sk-abcdefghijklmnop"]: "cache miss",
+      // Wrappers and byte views: exploded per index, a secret-shaped string stops matching any pattern.
+      boxed: new String("sk-abcdefghijklmnop"),
+      bytes: Buffer.from("Bearer supersecret"),
+    };
+  });
+
+  assert.equal(written.length, 1);
+  for (const secret of ["sk-abcdefghijklmnop", "supersecret", '"s","1":"k"']) {
+    assert.ok(!written[0].includes(secret), `secret reached the written line (${secret}): ${written[0]}`);
+  }
+  const fields = (JSON.parse(written[0]) as LogLine).fields.error as Record<string, unknown>;
+  assert.equal(fields["[REDACTED]"], "cache miss", "the secret-shaped key itself is scrubbed");
+  assert.equal(fields.boxed, "[REDACTED]", "a boxed secret is unwrapped back into something redaction sees");
+  assert.equal(fields.bytes, "[Buffer 18 bytes]", "a byte view is summarised, never spelled out");
+});
+
+test("a shared reference cannot amplify one failure into a huge line", async () => {
+  const written: string[] = [];
+  const queue = new JobQueue((l) => written.push(JSON.stringify(l)));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+
+  // A small DAG: each level references the one below it twice. Re-expanding per path instead of per value
+  // turns ~7 objects into hundreds of thousands of entries.
+  const leaf = { detail: "x".repeat(50) };
+  const mid = { a: leaf, b: leaf };
+  const top = { a: mid, b: mid };
+  await queue.run(() => {
+    throw { a: top, b: top };
+  });
+
