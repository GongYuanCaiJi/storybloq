+import test from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "./handler.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("a job enqueued by a request is traceable to that request when it fails", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp((l) => lines.push(l));
+  const res = await app.handle({ method: "POST", path: "/reports", headers: { "x-request-id": "req-http-2" }, body: { kind: "daily" } });
+  assert.equal(res.status, 202);
+
+  const result = await app.jobs.run(() => {
+    throw new Error("renderer exploded");
+  });
+
+  assert.deepEqual(result, { ran: 0, failed: 1 });
+  const failure = lines.find((l) => l.message === "job failed");
+  assert.ok(failure, "the failure reaches the sink the app was given");
+  assert.equal(failure.requestId, "req-http-2");
+  assert.deepEqual(failure.fields, { jobId: "job-1", kind: "report", error: "Error: renderer exploded" });
+});
