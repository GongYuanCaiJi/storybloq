+   * a job that somehow reached the queue without a usable request id fails loudly instead of
+   * vanishing -- `enqueue` already refuses one, and a swallowed throw there would be
+   * indistinguishable from a broken sink.
+   */
+  #logFailure(job: QueuedJob, err: unknown): void {
+    const log = AppLogger.withRequestId(job.requestId, this.#sink);
+    const fields = { jobId: job.id, kind: job.kind, error: describeError(err) };
+    try {
+      log.error("background job failed", fields);
+    } catch {
+      // A broken sink must not take the queue down with it.
+    }
+  }
 }
