diff --git a/src/jobs/JobQueue.test.ts b/src/jobs/JobQueue.test.ts
new file mode 100644
index 0000000..a36c788
--- /dev/null
+++ b/src/jobs/JobQueue.test.ts
@@ -0,0 +1,97 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { JobQueue, type QueuedJob } from "./JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("a failed job is logged under the request id that enqueued it, per job", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  const first = queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-b" });
+  const third = queue.enqueue({ kind: "digest", payload: null }, { requestId: "req-c" });
+
+  const counts = await queue.run((job: QueuedJob) => {
+    if (job.id !== first && job.id !== third) return;
+    throw new Error(`${job.kind} exploded`);
+  });
+
+  assert.deepEqual(counts, { ran: 1, failed: 2 });
+  assert.equal(lines.length, 2);
+  assert.equal(lines[0].level, "error");
+  assert.equal(lines[0].requestId, "req-a");
+  assert.equal(lines[0].message, "background job failed");
+  assert.deepEqual(lines[0].fields, { jobId: first, kind: "report", error: "report exploded" });
+  assert.equal(lines[1].requestId, "req-c");
+  assert.deepEqual(lines[1].fields, { jobId: third, kind: "digest", error: "digest exploded" });
+});
+
+test("secrets in a job failure are redacted before the line is written", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-secret" });
+
+  await queue.run(() => {
+    throw new Error("upstream refused Bearer abc");
+  });
+
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].requestId, "req-secret");
+  assert.equal(lines[0].fields.error, "upstream refused [REDACTED]");
+});
+
+test("a job that succeeds logs nothing", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-quiet" });
+
+  assert.deepEqual(await queue.run(() => {}), { ran: 1, failed: 0 });
+  assert.deepEqual(lines, []);
+});
+
+test("a job cannot be queued without a request id to trace it back to", () => {
+  const queue = new JobQueue();
+  assert.throws(() => queue.enqueue({ kind: "report", payload: null }, { requestId: "" }), /non-empty request id/);
+  assert.throws(() => queue.enqueue({ kind: "report", payload: null }, { requestId: "   " }), /non-empty request id/);
+  assert.equal(queue.size, 0);
+});
+
+test("a job that throws something undescribable is still logged under its request id", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  const nullProto = queue.enqueue({ kind: "report", payload: null }, { requestId: "req-null-proto" });
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-bad-getter" });
+
+  const counts = await queue.run((job: QueuedJob) => {
+    // String() cannot convert a null-prototype object; the getter raises on access.
+    if (job.id === nullProto) throw Object.create(null);
+    const err = new Error("ignored");
+    Object.defineProperty(err, "message", {
+      get() {
+        throw new Error("message getter is broken");
+      },
+    });
+    throw err;
+  });
+
+  assert.deepEqual(counts, { ran: 0, failed: 2 });
+  assert.deepEqual(
+    lines.map((l) => l.requestId),
+    ["req-null-proto", "req-bad-getter"],
+  );
+  for (const line of lines) assert.equal(line.fields.error, "<unprintable error>");
+});
+
+test("a throwing sink does not change what run reports, or stop the jobs behind it", async () => {
+  const queue = new JobQueue(() => {
+    throw new Error("sink is broken");
+  });
+  const failing = queue.enqueue({ kind: "report", payload: null }, { requestId: "req-1" });
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-2" });
+
+  const counts = await queue.run((job: QueuedJob) => {
+    if (job.id === failing) throw new Error("boom");
+  });
+
+  assert.deepEqual(counts, { ran: 1, failed: 1 });
+  assert.equal(queue.size, 0);
+});
