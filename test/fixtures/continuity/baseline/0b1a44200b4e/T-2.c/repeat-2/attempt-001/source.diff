+
 export interface Job {
   readonly kind: string;
   readonly payload: unknown;
@@ -15,11 +18,40 @@ export interface QueuedJob extends Job {
 
 export type JobRunner = (job: QueuedJob) => Promise<void> | void;
 
+/**
+ * Describes a thrown value without ever throwing itself. A job can throw anything: an Error with
+ * a getter that raises, or a null-prototype object that `String()` cannot convert. Those must not
+ * cost the failure its log line, which is the whole point of the ticket -- a job that fails in an
+ * unusual way is exactly the one worth tracing.
+ */
+function describeError(err: unknown): string {
+  try {
+    if (err instanceof Error && typeof err.message === "string") return err.message;
+    return String(err);
+  } catch {
+    return "<unprintable error>";
+  }
+}
+
 export class JobQueue {
   readonly #jobs: QueuedJob[] = [];
+  readonly #sink: Sink | undefined;
   #next = 1;
 
+  /** A sink can be supplied so a test can observe what a failing job logs; production uses AppLogger's default. */
+  constructor(sink?: Sink) {
+    this.#sink = sink;
+  }
+
+  /**
+   * Rejects an unusable request id here, where the caller can still see it. A job that cannot
+   * name its originating request is untraceable by construction, and accepting one only to
+   * discard it later, in the background, is the failure this ticket exists to remove. The check
+   * is AppLogger's own, not a copy of it, so the two cannot drift into a queue that accepts an
+   * id its logger will later refuse.
+   */
   enqueue(job: Job, opts: { requestId: string }): string {
+    if (!isUsableRequestId(opts.requestId)) throw new Error("JobQueue requires a non-empty request id");
     const id = `job-${this.#next++}`;
     this.#jobs.push({ ...job, id, requestId: opts.requestId, enqueuedAt: Date.now() });
     return id;
@@ -29,7 +61,10 @@ export class JobQueue {
     return this.#jobs.length;
   }
 
-  /** Runs every queued job in order. A failing job is dropped; the rest still run. */
+  /**
+   * Runs every queued job in order. A failing job is dropped and the rest still run, and the
+   * failure is logged under the request id of the request that enqueued that job.
+   */
   async run(runner: JobRunner): Promise<{ ran: number; failed: number }> {
     let ran = 0;
     let failed = 0;
@@ -38,10 +73,32 @@ export class JobQueue {
       try {
         await runner(job);
         ran++;
-      } catch {
+      } catch (err) {
+        this.#logFailure(job, err);
         failed++;
       }
     }
     return { ran, failed };
   }
+
+  /**
+   * One error line per failed job, under that job's own request id (never a fresh one). The
+   * payload is deliberately left out: it is arbitrary request body, and what makes the failure
+   * traceable is the request id plus the job id.
+   *
