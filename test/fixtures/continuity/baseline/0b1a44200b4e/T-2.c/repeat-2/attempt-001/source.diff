--- /dev/null
+++ b/src/http/handler.test.ts
@@ -0,0 +1,80 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "./handler.ts";
+import { JobQueue } from "../jobs/JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("a job that fails later is logged under the request id of the request that queued it", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l));
+
+  const res = await app.handle({
+    method: "POST",
+    path: "/reports",
+    headers: { "x-request-id": "req-http-fail" },
+    body: { kind: "daily" },
+  });
+  const { jobId } = res.body as { jobId: string };
+
+  const counts = await app.jobs.run(() => {
+    throw new Error("report generator exploded");
+  });
+
+  assert.deepEqual(counts, { ran: 0, failed: 1 });
+  const failure = lines.find((l) => l.message === "background job failed");
+  assert.ok(failure, "the failed job should have logged a line");
+  assert.equal(failure.requestId, "req-http-fail");
+  assert.deepEqual(failure.fields, { jobId, kind: "report", error: "report generator exploded" });
+});
+
+test("the app's default queue and its routes log to the same sink", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l));
+
+  await app.handle({ method: "POST", path: "/reports", headers: { "x-request-id": "req-one-sink" }, body: {} });
+  await app.jobs.run(() => {
+    throw new Error("boom");
+  });
+
+  assert.deepEqual(
+    lines.map((l) => l.message),
+    ["report queued", "background job failed"],
+  );
+  for (const line of lines) assert.equal(line.requestId, "req-one-sink");
+});
+
+test("a caller-supplied queue built from the same sink keeps both halves together", async () => {
+  const lines: LogLine[] = [];
+  const sink = (l: LogLine) => lines.push(l);
+  // The documented remedy for the one split createApp does not close for you: a queue passed in
+  // keeps its OWN sink, so build it from the same one.
+  const app = createApp(new JobQueue(sink), sink);
+
+  await app.handle({ method: "POST", path: "/reports", headers: { "x-request-id": "req-supplied" }, body: {} });
+  await app.jobs.run(() => {
+    throw new Error("boom");
+  });
+
+  assert.deepEqual(
+    lines.map((l) => l.message),
+    ["report queued", "background job failed"],
+  );
+  for (const line of lines) assert.equal(line.requestId, "req-supplied");
+});
+
+test("each queued request's failure is traceable to its own request, not the last one", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l));
+
+  await app.handle({ method: "POST", path: "/reports", headers: { "x-request-id": "req-first" }, body: {} });
+  await app.handle({ method: "POST", path: "/reports", headers: { "x-request-id": "req-second" }, body: {} });
+  await app.jobs.run(() => {
+    throw new Error("boom");
+  });
+
+  const failures = lines.filter((l) => l.message === "background job failed");
+  assert.deepEqual(
+    failures.map((l) => l.requestId),
+    ["req-first", "req-second"],
+  );
+});
