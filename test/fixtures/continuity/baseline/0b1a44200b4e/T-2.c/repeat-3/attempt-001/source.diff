diff --git a/src/jobs/JobQueue.test.ts b/src/jobs/JobQueue.test.ts
new file mode 100644
index 0000000..4c26b89
--- /dev/null
+++ b/src/jobs/JobQueue.test.ts
@@ -0,0 +1,146 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { JobQueue, type QueuedJob } from "./JobQueue.ts";
+import { AppLogger, type LogLine } from "../platform/logging/AppLogger.ts";
+
+/** Three jobs from three different requests; the first and third fail, the middle one succeeds. */
+function queueOfThree(lines: LogLine[]): { queue: JobQueue; ranKinds: string[] } {
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "first", payload: null }, { requestId: "req-a" });
+  queue.enqueue({ kind: "second", payload: null }, { requestId: "req-b" });
+  queue.enqueue({ kind: "third", payload: null }, { requestId: "req-c" });
+  return { queue, ranKinds: [] };
+}
+
+const failFirstAndThird = (ranKinds: string[]) => (job: QueuedJob) => {
+  if (job.kind === "first" || job.kind === "third") throw new Error(`${job.kind} blew up`);
+  ranKinds.push(job.kind);
+};
+
+test("a failed job is logged under the request id that enqueued it", async () => {
+  const lines: LogLine[] = [];
+  const { queue, ranKinds } = queueOfThree(lines);
+
+  await queue.run(failFirstAndThird(ranKinds));
+
+  // One line per failure, each under its OWN job's request id -- not a fresh id, and not one id
+  // reused for both, which is what a logger hoisted out of the loop would produce.
+  assert.equal(lines.length, 2);
+  assert.deepEqual(lines.map((l) => l.requestId), ["req-a", "req-c"]);
+  for (const line of lines) assert.equal(line.level, "error");
+  assert.equal(lines[0].message, "job failed");
+  assert.deepEqual(lines[0].fields, { jobId: "job-1", kind: "first", error: "first blew up" });
+  assert.deepEqual(lines[1].fields, { jobId: "job-3", kind: "third", error: "third blew up" });
+});
+
+test("a failing job is still dropped and the rest of the queue still runs", async () => {
+  const lines: LogLine[] = [];
+  const { queue, ranKinds } = queueOfThree(lines);
+
+  const result = await queue.run(failFirstAndThird(ranKinds));
+
+  assert.deepEqual(result, { ran: 1, failed: 2 });
+  assert.deepEqual(ranKinds, ["second"]);
+  assert.equal(queue.size, 0);
+});
+
+test("the runner is handed a logger already bound to the job's request id", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-enqueued-me" });
+
+  let received: AppLogger | undefined;
+  await queue.run((_job, log) => {
+    received = log;
+    log.info("working");
+  });
+
+  assert.equal(received?.requestId, "req-enqueued-me");
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].requestId, "req-enqueued-me");
+  assert.equal(lines[0].message, "working");
+});
+
+test("a secret in the failure reason is redacted before the line is written", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-secret" });
+
+  await queue.run(() => {
+    throw new Error("upstream refused Bearer abc");
+  });
+
+  assert.equal(lines.length, 1);
+  assert.deepEqual(lines[0].fields, { jobId: "job-1", kind: "report", error: "upstream refused [REDACTED]" });
+});
+
+test("a job that throws a non-Error is logged and dropped like any other failure", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "stringy", payload: null }, { requestId: "req-1" });
+  queue.enqueue({ kind: "objecty", payload: null }, { requestId: "req-2" });
+
+  const result = await queue.run((job) => {
+    throw job.kind === "stringy" ? "just a string" : { code: 1 };
+  });
+
+  assert.deepEqual(result, { ran: 0, failed: 2 });
+  assert.equal(lines[0].fields.error, "just a string");
+  assert.equal(lines[1].fields.error, "[object Object]");
+});
+
+test("a thrown value that cannot be described does not abandon the rest of the queue", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "no-prototype", payload: null }, { requestId: "req-1" });
+  queue.enqueue({ kind: "throwing-tostring", payload: null }, { requestId: "req-2" });
+  queue.enqueue({ kind: "innocent", payload: null }, { requestId: "req-3" });
+
+  // Both of these make String(err) itself throw. If that escaped run()'s catch, one bad job would
+  // take the whole queue down with it and the innocent job behind them would never run.
+  const result = await queue.run((job) => {
+    if (job.kind === "no-prototype") throw Object.create(null);
+    if (job.kind === "throwing-tostring") {
+      throw {
+        toString() {
+          throw new Error("boom");
+        },
+      };
+    }
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 2 });
+  assert.equal(queue.size, 0);
+  assert.equal(lines.length, 2);
+  assert.deepEqual(lines.map((l) => l.requestId), ["req-1", "req-2"]);
+  for (const line of lines) assert.equal(line.fields.error, "<thrown value could not be described>");
+});
+
+test("a sink that throws does not abandon the rest of the queue either", async () => {
+  // The sink is reached synchronously from log.error, which now runs inside run()'s catch. A sink
+  // that throws there must not turn one job's failure into the whole queue's failure.
+  const queue = new JobQueue(() => {
+    throw new Error("stdout is gone");
+  });
+  queue.enqueue({ kind: "doomed", payload: null }, { requestId: "req-1" });
+  queue.enqueue({ kind: "innocent", payload: null }, { requestId: "req-2" });
+
+  let innocentRan = false;
+  const result = await queue.run((job) => {
+    if (job.kind === "doomed") throw new Error("nope");
+    innocentRan = true;
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  assert.equal(innocentRan, true);
+  assert.equal(queue.size, 0);
+});
+
+test("a job with no usable request id is refused at enqueue", () => {
+  const queue = new JobQueue();
+  const job = { kind: "report", payload: null };
+
+  assert.throws(() => queue.enqueue(job, { requestId: "" }), /non-empty request id/);
+  assert.throws(() => queue.enqueue(job, { requestId: "  " }), /non-empty request id/);
+  assert.equal(queue.size, 0);
+});
