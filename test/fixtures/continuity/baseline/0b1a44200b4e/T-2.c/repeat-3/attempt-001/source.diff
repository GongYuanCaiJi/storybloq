   async run(runner: JobRunner): Promise<{ ran: number; failed: number }> {
     let ran = 0;
     let failed = 0;
     while (this.#jobs.length > 0) {
       const job = this.#jobs.shift()!;
+      const log = AppLogger.withRequestId(job.requestId, this.#sink);
