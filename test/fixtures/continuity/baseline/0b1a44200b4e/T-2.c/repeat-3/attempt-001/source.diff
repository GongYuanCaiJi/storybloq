 }
 
-export type JobRunner = (job: QueuedJob) => Promise<void> | void;
+/** Receives a logger bound to the job's originating request id; log through it, not a fresh one. */
+export type JobRunner = (job: QueuedJob, log: AppLogger) => Promise<void> | void;
+
+/**
+ * A job may throw anything, not just an Error, and describing the thrown value can itself throw:
+ * `String(Object.create(null))` and a value whose toString throws both do. Since this runs inside
+ * run()'s catch, an escaping throw there would abandon every job still queued -- the failure of one
+ * job would silently become the failure of the whole queue. So it is contained here.
+ */
+function describeError(err: unknown): string {
+  try {
+    return err instanceof Error ? String(err.message) : String(err);
+  } catch {
+    return "<thrown value could not be described>";
+  }
+}
 
 export class JobQueue {
   readonly #jobs: QueuedJob[] = [];
+  readonly #sink: Sink | undefined;
   #next = 1;
 
+  /** A sink can be supplied so a test can observe what jobs log; production uses AppLogger's default. */
