+import test from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "./handler.ts";
+import { JobQueue } from "../jobs/JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("a job that fails is traceable to the request that enqueued it", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  const app = createApp(queue, (l) => lines.push(l));
+
+  const res = await app.handle({
+    method: "POST",
+    path: "/reports",
+    headers: { "x-request-id": "req-http-9" },
+    body: { kind: "daily" },
+  });
+  assert.equal(res.status, 202);
+
+  const result = await queue.run(() => {
+    throw new Error("report generation failed");
+  });
+  assert.deepEqual(result, { ran: 0, failed: 1 });
+
+  // The whole path: the id is born at the HTTP edge, recorded at enqueue, and emitted on failure.
+  const failures = lines.filter((l) => l.message === "job failed");
+  assert.equal(failures.length, 1);
+  assert.equal(failures[0].requestId, "req-http-9");
+  assert.equal(failures[0].fields.error, "report generation failed");
+  assert.equal(failures[0].fields.jobId, (res.body as { jobId: string }).jobId);
+});
