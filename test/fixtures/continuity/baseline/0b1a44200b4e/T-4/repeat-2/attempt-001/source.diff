diff --git a/src/http/RateLimiter.test.ts b/src/http/RateLimiter.test.ts
new file mode 100644
index 0000000..90dcf9a
--- /dev/null
+++ b/src/http/RateLimiter.test.ts
@@ -0,0 +1,102 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { RateLimiter } from "./RateLimiter.ts";
+
+/** A clock a test can move by hand, so window behaviour is deterministic without sleeping. */
+function clock(start = 0): { now: () => number; advance: (ms: number) => void } {
+  let t = start;
+  return { now: () => t, advance: (ms) => { t += ms; } };
+}
+
+test("allows exactly limit requests in a window, then rejects, counting remaining down to zero", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 3, windowMs: 1000, now: c.now });
+
+  assert.deepEqual(limiter.check("a"), { allowed: true, remaining: 2, retryAfterMs: 0 });
+  assert.deepEqual(limiter.check("a"), { allowed: true, remaining: 1, retryAfterMs: 0 });
+  assert.deepEqual(limiter.check("a"), { allowed: true, remaining: 0, retryAfterMs: 0 });
+
+  const rejected = limiter.check("a");
+  assert.equal(rejected.allowed, false);
+});
+
+test("a new window restores the full allowance", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 2, windowMs: 1000, now: c.now });
+
+  limiter.check("a");
+  limiter.check("a");
+  assert.equal(limiter.check("a").allowed, false);
+
+  c.advance(1000);
+  assert.deepEqual(limiter.check("a"), { allowed: true, remaining: 1, retryAfterMs: 0 });
+});
+
+test("one client exhausting its window does not consume another client's allowance", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 1, windowMs: 1000, now: c.now });
+
+  assert.equal(limiter.check("noisy").allowed, true);
+  assert.equal(limiter.check("noisy").allowed, false);
+  assert.equal(limiter.check("quiet").allowed, true);
+});
+
+test("a rejection reports no remaining and the time left in the window", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 1, windowMs: 1000, now: c.now });
+
+  limiter.check("a"); // window starts at t=0
+  c.advance(400);
+
+  assert.deepEqual(limiter.check("a"), { allowed: false, remaining: 0, retryAfterMs: 600 });
+});
+
+test("expired entries are swept rather than accumulating, without changing any verdict", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 2, windowMs: 1000, now: c.now });
+
+  limiter.check("a");
+  limiter.check("b");
+  limiter.check("c");
+  assert.equal(limiter.size, 3);
+
+  c.advance(1500); // every window above has expired
+  limiter.check("d");
+  assert.equal(limiter.size, 1, "the three expired entries are gone, the live one remains");
+
+  // A swept key gets exactly the verdict an untouched limiter would have given it:
+  // its window had expired, so it starts fresh either way.
+  assert.deepEqual(limiter.check("a"), { allowed: true, remaining: 1, retryAfterMs: 0 });
+});
+
+test("a sweep deletes expired windows and leaves live ones untouched", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 2, windowMs: 1000, now: c.now });
+
+  // #lastSweep starts at 0, so this call is the first that can sweep. It finds an
+  // empty map, sets #lastSweep to 1000, and installs "a" with a window at t=1000.
+  c.advance(1000);
+  limiter.check("a");
+
+  // Throttled (only 500ms since the last sweep). "b" gets a window at t=1500.
+  c.advance(500);
+  limiter.check("b");
+
+  // 1000ms since the last sweep, so this one runs with both entries in the map:
+  // "a" is 1000ms old and expired, "b" is 500ms old and live.
+  c.advance(500);
+  limiter.check("c");
+
+  assert.equal(limiter.size, 2, "the expired entry is gone; the live one and the new one remain");
+
+  // "b" kept its count through the sweep. Had the sweep evicted it, this would read
+  // as a fresh window (remaining 1) -- which is how a flood of distinct keys would
+  // clear a victim's counter.
+  assert.deepEqual(limiter.check("b"), { allowed: true, remaining: 0, retryAfterMs: 0 });
+  assert.equal(limiter.check("b").allowed, false);
+});
+
+test("a misconfigured limiter fails loudly at construction", () => {
+  assert.throws(() => new RateLimiter({ limit: 0, windowMs: 1000 }), /limit >= 1/);
+  assert.throws(() => new RateLimiter({ limit: 1, windowMs: 0 }), /windowMs >= 1/);
+});
diff --git a/src/http/RateLimiter.ts b/src/http/RateLimiter.ts
new file mode 100644
index 0000000..bb1f68f
--- /dev/null
+++ b/src/http/RateLimiter.ts
@@ -0,0 +1,99 @@
+/**
+ * Fixed-window rate limiting, one window per key.
+ *
+ * The limiter is pure bookkeeping: it decides, it does not log. Anything worth
+ * saying about a rejection is said by the caller, through AppLogger, under the
+ * request id that caller already holds.
+ */
+
+export interface RateLimitOptions {
+  /** Requests allowed per window. Must be >= 1. */
+  readonly limit: number;
+  /** Window length in milliseconds. Must be >= 1. */
+  readonly windowMs: number;
+  /** Injectable clock, so a test can move time without sleeping. */
+  readonly now?: () => number;
+}
+
+export interface RateLimitResult {
+  readonly allowed: boolean;
+  /** Requests left in the current window; 0 on a rejection. */
+  readonly remaining: number;
+  /** Time left in the current window; 0 when allowed. */
+  readonly retryAfterMs: number;
+}
+
+interface Window {
+  windowStart: number;
+  count: number;
+}
+
+export class RateLimiter {
+  readonly #limit: number;
+  readonly #windowMs: number;
+  readonly #now: () => number;
+  readonly #windows = new Map<string, Window>();
+  #lastSweep: number;
+
+  constructor(opts: RateLimitOptions) {
+    if (!Number.isFinite(opts.limit) || opts.limit < 1) {
+      throw new Error("RateLimiter requires limit >= 1");
+    }
+    if (!Number.isFinite(opts.windowMs) || opts.windowMs < 1) {
+      throw new Error("RateLimiter requires windowMs >= 1");
+    }
+    this.#limit = opts.limit;
+    this.#windowMs = opts.windowMs;
+    this.#now = opts.now ?? Date.now;
+    this.#lastSweep = this.#now();
+  }
+
+  /** Number of tracked keys. Exists so the sweep is observable from a test. */
+  get size(): number {
+    return this.#windows.size;
+  }
+
+  /**
+   * Records one request against `key` and says whether it is allowed. This is the
+   * only mutation point, so one call consumes exactly one slot.
+   */
+  check(key: string): RateLimitResult {
+    const now = this.#now();
+    this.#sweep(now);
+
+    // A first request and an expired window are the same case: install a fresh window.
+    let window = this.#windows.get(key);
+    if (window === undefined || now - window.windowStart >= this.#windowMs) {
+      window = { windowStart: now, count: 0 };
+      this.#windows.set(key, window);
+    }
+
+    if (window.count < this.#limit) {
+      // Increment first, then compute: the first allowed call of a limit-5 window
+      // reports 4 remaining and the last reports 0. Pre-increment would advertise
+      // a slot that does not exist.
+      window.count++;
+      return { allowed: true, remaining: this.#limit - window.count, retryAfterMs: 0 };
+    }
+
+    return { allowed: false, remaining: 0, retryAfterMs: window.windowStart + this.#windowMs - now };
+  }
+
+  /**
+   * Drops entries that have outlived their window, at most once per window.
+   *
+   * An expired entry is indistinguishable from no entry, so this can never change a
+   * verdict. The throttle is what keeps the walk from becoming a per-request O(n)
+   * scan under a flood of distinct keys -- the case this limiter exists to survive.
+   * Live windows are never evicted: doing so would reset a client's allowance, which
+   * is a way to clear a victim's counter, so the map is bounded by the number of
+   * distinct keys seen across two consecutive windows.
+   */
+  #sweep(now: number): void {
+    if (now - this.#lastSweep < this.#windowMs) return;
+    this.#lastSweep = now;
+    for (const [key, window] of this.#windows) {
+      if (now - window.windowStart >= this.#windowMs) this.#windows.delete(key);
+    }
+  }
+}
diff --git a/src/http/handler.test.ts b/src/http/handler.test.ts
new file mode 100644
index 0000000..2a055ff
--- /dev/null
+++ b/src/http/handler.test.ts
@@ -0,0 +1,114 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "./handler.ts";
+import { JobQueue } from "../jobs/JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+/**
+ * A frozen clock. retryAfterMs is derived from two separate clock reads, so asserting
+ * an exact value against the wall clock fails whenever a millisecond boundary falls
+ * between them.
+ */
+const frozen = { now: () => 0 };
+
+test("an exhausted client window answers 429 without enqueueing, and does not starve another client", async () => {
+  const queue = new JobQueue();
+  const app = createApp(queue, () => {}, { rateLimit: { limit: 1, windowMs: 60_000, ...frozen } });
+  const post = (clientId: string) =>
+    app.handle({ method: "POST", path: "/reports", headers: { "x-client-id": clientId }, body: { kind: "daily" } });
+
+  assert.equal((await post("c1")).status, 202);
+
+  const rejected = await post("c1");
+  assert.equal(rejected.status, 429);
+  assert.deepEqual(rejected.body, { error: "rate limited", retryAfterMs: 60_000 });
+  assert.equal(queue.size, 1, "the rejected request enqueued nothing");
+
+  assert.equal((await post("c2")).status, 202, "c1 exhausting its window leaves c2 unaffected");
+  assert.equal(queue.size, 2);
+});
+
+test("a rate-limited request logs under the request id the handler layer assigned", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l), { rateLimit: { limit: 1, windowMs: 60_000, ...frozen } });
+  const post = (requestId: string) =>
+    app.handle({
+      method: "POST",
+      path: "/reports",
+      headers: { "x-request-id": requestId, "x-client-id": "c1" },
+      body: { kind: "daily" },
+    });
+
+  await post("req-allowed");
+  await post("req-limited");
+
+  // The allowed request logged "report queued" to the same sink, so find the warn line.
+  const warned = lines.filter((l) => l.level === "warn" && l.message === "rate limited");
+  assert.equal(warned.length, 1);
+  assert.equal(warned[0].requestId, "req-limited");
+  assert.equal(warned[0].fields.clientId, "c1");
+});
+
+test("requests without an x-client-id share one bucket rather than bypassing the limit", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1, windowMs: 60_000, ...frozen } });
+  const get = () => app.handle({ method: "GET", path: "/health", headers: {} });
+
+  assert.equal((await get()).status, 200);
+  assert.equal((await get()).status, 429);
+});
+
+test("a whitespace-only client id is treated as no client id at all", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1, windowMs: 60_000, ...frozen } });
+
+  const blank = await app.handle({ method: "GET", path: "/health", headers: { "x-client-id": "   " } });
+  assert.equal(blank.status, 200);
+
+  // Same bucket as a request that omits the header: without the trim it would have
+  // got a private allowance of its own.
+  const absent = await app.handle({ method: "GET", path: "/health", headers: {} });
+  assert.equal(absent.status, 429);
+});
+
+test("a client id cannot be chosen to collide with the unidentified bucket", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1, windowMs: 60_000, ...frozen } });
+
+  const named = await app.handle({ method: "GET", path: "/health", headers: { "x-client-id": "anon" } });
+  assert.equal(named.status, 200);
+
+  const anonymous = await app.handle({ method: "GET", path: "/health", headers: {} });
+  assert.equal(anonymous.status, 200, "the unidentified bucket still has its own allowance");
+});
+
+test("an unknown path costs the caller a slot, so 404s cannot be used to evade the limit", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1, windowMs: 60_000, ...frozen } });
+  const headers = { "x-client-id": "c1" };
+
+  assert.equal((await app.handle({ method: "GET", path: "/nope", headers })).status, 404);
+  assert.equal((await app.handle({ method: "GET", path: "/health", headers })).status, 429);
+});
+
