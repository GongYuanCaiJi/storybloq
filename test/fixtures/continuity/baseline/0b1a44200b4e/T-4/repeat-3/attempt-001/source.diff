new file mode 100644
index 0000000..3e19f8a
--- /dev/null
+++ b/src/http/RateLimiter.ts
@@ -0,0 +1,125 @@
+/**
+ * Fixed-window per-client rate limiting.
+ *
+ * One window per client id: `count` requests are admitted in each `windowMs`
+ * stretch, and the window resets wholesale once it has elapsed. The clock is
+ * injectable so a test can roll a window over without sleeping.
+ *
+ * The client id is a caller-supplied header, so the number of distinct keys is
+ * not something this module can trust. `maxTrackedClients` is therefore a HARD
+ * cap enforced by eviction, not a sweep of expired entries: under a client that
+ * rotates its id every request every entry is live, and a sweep would reclaim
+ * nothing while charging a scan for the privilege. See plan.md for the cost of
+ * that eviction, which is real and deliberate.
+ */
+export interface RateLimitDecision {
+  readonly allowed: boolean;
+  /** The window's limit, so a caller can report it without reaching into config. */
+  readonly limit: number;
+  /** Requests left in the current window after this decision. */
+  readonly remaining: number;
+  /** Epoch ms at which the current window ends. */
+  readonly resetAt: number;
+  /** Seconds until the window resets; 0 when the request was allowed. */
+  readonly retryAfterSeconds: number;
+}
+
+export interface RateLimiterOptions {
+  readonly limit?: number;
+  readonly windowMs?: number;
+  readonly now?: () => number;
+  readonly maxTrackedClients?: number;
+}
+
+interface Window {
+  windowStart: number;
+  count: number;
+}
+
+const DEFAULT_LIMIT = 100;
+const DEFAULT_WINDOW_MS = 60_000;
+const DEFAULT_MAX_TRACKED_CLIENTS = 10_000;
+
+export class RateLimiter {
+  readonly #limit: number;
+  readonly #windowMs: number;
+  readonly #now: () => number;
+  readonly #maxTrackedClients: number;
+
+  /**
+   * Keyed by client id, held in window order: insertion order tracks
+   * `windowStart` ascending, so the first entry is the oldest window and
+   * eviction is a single delete rather than a scan. Every path that can change
+   * a `windowStart` re-inserts the entry to keep that true.
+   */
+  readonly #windows = new Map<string, Window>();
+
+  constructor(options: RateLimiterOptions = {}) {
+    // Validated rather than trusted: the cap is enforced by `size >= max`, and a
+    // NaN there is false forever, which would silently leave the map unbounded --
+    // the exact failure the cap exists to prevent. A misconfiguration should be
+    // loud at construction, not a quiet loss of the bound under load.
+    this.#limit = positiveInteger(options.limit, DEFAULT_LIMIT, "limit");
+    this.#windowMs = positiveInteger(options.windowMs, DEFAULT_WINDOW_MS, "windowMs");
+    this.#maxTrackedClients = positiveInteger(options.maxTrackedClients, DEFAULT_MAX_TRACKED_CLIENTS, "maxTrackedClients");
+    this.#now = options.now ?? Date.now;
+  }
+
+  /** Clients currently tracked. Bounded by `maxTrackedClients` whatever callers send. */
+  get size(): number {
+    return this.#windows.size;
+  }
+
+  check(clientId: string): RateLimitDecision {
+    const now = this.#now();
+    const window = this.#windowFor(clientId, now);
+    const resetAt = window.windowStart + this.#windowMs;
+
+    if (window.count + 1 > this.#limit) {
+      // A denial does not increment the count: the window's end is fixed by
+      // windowStart, so counting denials would only inflate the counter.
+      return {
+        allowed: false,
+        limit: this.#limit,
+        remaining: 0,
+        resetAt,
+        // A denial only happens while now < resetAt, so this is always >= 1.
+        retryAfterSeconds: Math.ceil((resetAt - now) / 1000),
+      };
+    }
+
+    window.count++;
+    return { allowed: true, limit: this.#limit, remaining: this.#limit - window.count, resetAt, retryAfterSeconds: 0 };
+  }
+
+  /** The client's current window, resetting or creating it as needed, keeping window order intact. */
+  #windowFor(clientId: string, now: number): Window {
+    const existing = this.#windows.get(clientId);
+    if (existing) {
+      if (now - existing.windowStart < this.#windowMs) return existing;
+      // Reset: the window start moves, so the entry moves to the tail with it.
+      this.#windows.delete(clientId);
+      const reset: Window = { windowStart: now, count: 0 };
+      this.#windows.set(clientId, reset);
+      return reset;
+    }
+
+    if (this.#windows.size >= this.#maxTrackedClients) this.#evictOldest();
+    const fresh: Window = { windowStart: now, count: 0 };
+    this.#windows.set(clientId, fresh);
+    return fresh;
+  }
+
+  #evictOldest(): void {
+    const oldest = this.#windows.keys().next();
+    if (!oldest.done) this.#windows.delete(oldest.value);
+  }
+}
+
+function positiveInteger(value: number | undefined, fallback: number, name: string): number {
+  if (value === undefined) return fallback;
+  if (!Number.isInteger(value) || value < 1) {
+    throw new Error(`RateLimiter ${name} must be a positive integer, got ${value}`);
+  }
+  return value;
+}
diff --git a/src/http/handler.test.ts b/src/http/handler.test.ts
new file mode 100644
index 0000000..e13aee1
--- /dev/null
+++ b/src/http/handler.test.ts
@@ -0,0 +1,109 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "./handler.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+/** A stub clock, so retryAfterSeconds is exact rather than a race with the wall clock. */
+function clock(start = 1_000_000) {
+  let now = start;
+  return { now: () => now, advance: (ms: number) => { now += ms; } };
+}
+
+test("an exhausted client gets a 429, logged under that request's own id", async () => {
+  const lines: LogLine[] = [];
+  const c = clock();
+  const app = createApp(undefined, (l) => lines.push(l), { rateLimit: { limit: 1, windowMs: 60_000, now: c.now } });
+
+  const first = await app.handle({ method: "POST", path: "/reports", headers: { "x-client-id": "c1" }, body: { kind: "daily" } });
+  assert.equal(first.status, 202);
+
+  // Time moves between the two calls, so the exact retryAfterSeconds below is a
+  // real assertion about the arithmetic rather than a same-millisecond accident.
+  c.advance(15_000);
+
+  // The refused request names its own request id, so the assertion below can
+  // check the ruling's guarantee rather than a generated uuid.
+  const refused = await app.handle({
+    method: "POST",
+    path: "/reports",
+    headers: { "x-client-id": "c1", "x-request-id": "req-429" },
+    body: { kind: "daily" },
+  });
+  assert.equal(refused.status, 429);
+  assert.deepEqual(refused.body, { error: "rate limit exceeded", retryAfterSeconds: 45 });
+
+  // The sink holds the 202's "report queued" line too, so select the refusal.
+  const rateLimited = lines.filter((l) => l.message === "rate limited");
+  assert.equal(rateLimited.length, 1);
+  assert.equal(rateLimited[0].level, "warn");
+  assert.equal(rateLimited[0].requestId, "req-429");
+  assert.deepEqual(rateLimited[0].fields, { clientId: "c1", limit: 1, retryAfterSeconds: 45 });
+});
+
+test("requests without an x-client-id share one bucket rather than bypassing the limit", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1 } });
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers: {}, body: {} })).status, 202);
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers: {}, body: {} })).status, 429);
+});
+
+test("the client id header is matched case-insensitively", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1 } });
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers: { "X-Client-Id": "c1" }, body: {} })).status, 202);
+  // A different spelling of the same header must not buy a fresh window.
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers: { "x-client-id": "c1" }, body: {} })).status, 429);
+});
+
+test("a header carrying an undefined value does not hide a later spelling of it", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1 } });
+  const headers = { "X-Client-Id": undefined, "x-client-id": "c1" };
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers, body: {} })).status, 202);
+  // Charged to "c1", not to the shared anonymous bucket, so "c1" is now spent.
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers: { "x-client-id": "c1" }, body: {} })).status, 429);
+});
+
+test("unrouted paths spend quota but health checks are exempt", async () => {
+  const app = createApp(undefined, () => {}, { rateLimit: { limit: 1 } });
+  const headers = { "x-client-id": "c1" };
+
+  // A 404 still costs the handler its work, so it counts.
+  assert.equal((await app.handle({ method: "GET", path: "/nope", headers })).status, 404);
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers, body: {} })).status, 429);
+
+  // The exemption is scoped to the method too: POST /health is not a free
+  // channel, it is a spent client's 429 like any other path.
+  assert.equal((await app.handle({ method: "POST", path: "/health", headers, body: {} })).status, 429);
+
+  // The probe keeps answering even though the client's window is spent -- and
+  // even for a header-less probe whose "anonymous" bucket others have drained.
+  assert.equal((await app.handle({ method: "GET", path: "/health", headers })).status, 200);
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers: {}, body: {} })).status, 202);
+  assert.equal((await app.handle({ method: "POST", path: "/reports", headers: {}, body: {} })).status, 429);
+  assert.equal((await app.handle({ method: "GET", path: "/health", headers: {} })).status, 200);
+});
+
+test("the request id header is matched case-insensitively too", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l));
+  await app.handle({ method: "POST", path: "/reports", headers: { "X-Request-Id": "req-cased" }, body: {} });
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].requestId, "req-cased");
+});
+
+test("a blank request id header is treated as absent rather than rejected", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l));
+  const res = await app.handle({ method: "POST", path: "/reports", headers: { "x-request-id": "   " }, body: {} });
+  assert.equal(res.status, 202);
+  assert.equal(lines.length, 1);
+  assert.notEqual(lines[0].requestId.trim(), "");
+});
+
+test("an allowed request still routes and logs exactly as before", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l));
+  const res = await app.handle({ method: "POST", path: "/reports", headers: { "x-request-id": "req-1", "x-client-id": "c1" }, body: { kind: "daily" } });
+  assert.equal(res.status, 202);
+  assert.equal(lines.length, 1);
+  assert.equal(lines[0].message, "report queued");
+  assert.equal(lines[0].requestId, "req-1");
+});
