diff --git a/src/http/RateLimiter.test.ts b/src/http/RateLimiter.test.ts
new file mode 100644
index 0000000..5d42b98
--- /dev/null
+++ b/src/http/RateLimiter.test.ts
@@ -0,0 +1,143 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { RateLimiter } from "./RateLimiter.ts";
+
+/** A stub clock, so a window can be rolled over without sleeping. */
+function clock(start = 1_000_000) {
+  let now = start;
+  return { now: () => now, advance: (ms: number) => { now += ms; }, at: () => now };
+}
+
+test("a fixed window admits up to the limit, then refuses", () => {
+  const c = clock();
+  const start = c.at();
+  const limiter = new RateLimiter({ limit: 2, windowMs: 60_000, now: c.now });
+  assert.equal(limiter.check("c1").remaining, 1);
+  assert.equal(limiter.check("c1").remaining, 0);
+
+  c.advance(20_000);
+  const denied = limiter.check("c1");
+  assert.equal(denied.allowed, false);
+  assert.equal(denied.remaining, 0);
+  // resetAt is fixed by windowStart, not by now -- if it tracked `now` this
+  // would be start + 80_000 and the window would be sliding, not fixed.
+  assert.equal(denied.resetAt, start + 60_000);
+  assert.equal(denied.retryAfterSeconds, 40);
+});
+
+test("a denial with a millisecond left still reports a whole second", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 1, windowMs: 60_000, now: c.now });
+  limiter.check("c1");
+  c.advance(59_999); // 1ms left: still refused, and still a usable retry hint
+  const denied = limiter.check("c1");
+  assert.equal(denied.allowed, false);
+  assert.equal(denied.retryAfterSeconds, 1);
+});
+
+test("one client exhausting its window does not starve another", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 1, windowMs: 60_000, now: c.now });
+  assert.equal(limiter.check("c1").allowed, true);
+  assert.equal(limiter.check("c1").allowed, false);
+  assert.equal(limiter.check("c2").allowed, true);
+});
+
+test("the window resets once it has elapsed", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 2, windowMs: 60_000, now: c.now });
+  limiter.check("c1");
+  limiter.check("c1");
+  assert.equal(limiter.check("c1").allowed, false);
+
+  c.advance(60_000);
+  const afterReset = limiter.check("c1");
+  assert.equal(afterReset.allowed, true);
+  assert.equal(afterReset.remaining, 1);
+});
+
+test("an allowed request reports the window's own end, not a sliding one", () => {
+  const c = clock();
+  const start = c.at();
+  const limiter = new RateLimiter({ limit: 5, windowMs: 60_000, now: c.now });
+  assert.equal(limiter.check("c1").resetAt, start + 60_000);
+  c.advance(10_000);
+  assert.equal(limiter.check("c1").resetAt, start + 60_000);
+});
+
+test("options that would silently unbound the cap are rejected at construction", () => {
+  // NaN is the live case: `size >= NaN` is false forever, so eviction would
+  // never fire and the map would grow without limit.
+  assert.throws(() => new RateLimiter({ maxTrackedClients: Number.NaN }), /positive integer/);
+  assert.throws(() => new RateLimiter({ maxTrackedClients: 0 }), /positive integer/);
+  assert.throws(() => new RateLimiter({ maxTrackedClients: 2.5 }), /positive integer/);
+  assert.throws(() => new RateLimiter({ limit: -1 }), /positive integer/);
+  assert.throws(() => new RateLimiter({ windowMs: Number.NaN }), /positive integer/);
+});
+
+test("a denied request does not push the window's reset out", () => {
+  const c = clock();
+  const start = c.at();
+  const limiter = new RateLimiter({ limit: 1, windowMs: 60_000, now: c.now });
+  assert.equal(limiter.check("c1").allowed, true);
+
+  // The denials happen strictly inside the window. Without this advance the
+  // denials would share an instant with windowStart and the final assertion
+  // would hold whether or not a denial had moved it.
+  c.advance(30_000);
+  assert.equal(limiter.check("c1").allowed, false);
+  assert.equal(limiter.check("c1").allowed, false);
+
+  // Exactly one window after the ORIGINAL start. Had a denial reset
+  // windowStart to start + 30s, this would still be refused.
+  c.advance(30_000);
+  assert.equal(c.at(), start + 60_000);
+  assert.equal(limiter.check("c1").allowed, true);
+});
+
+test("the tracked-client cap is hard and evicts the oldest window", () => {
+  const c = clock();
+  // limit: 1 is what makes this discriminate -- at a higher limit `a` would be
+  // admitted again whether or not it had been evicted.
+  const limiter = new RateLimiter({ limit: 1, windowMs: 60_000, maxTrackedClients: 2, now: c.now });
+
+  assert.equal(limiter.check("a").allowed, true);
+  c.advance(1_000);
+  assert.equal(limiter.check("b").allowed, true);
+  c.advance(1_000);
+  assert.equal(limiter.check("c").allowed, true); // evicts `a`, the oldest window
+  assert.equal(limiter.size, 2);
+
+  // `a` is allowed again only because its counter was evicted; `b` is still
+  // tracked and still denied. Every window here is live -- nothing expired.
+  assert.equal(limiter.check("b").allowed, false);
+  assert.equal(limiter.check("a").allowed, true);
+  assert.equal(limiter.size, 2);
+});
+
+test("a reset moves a client to the back of the eviction order", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 1, windowMs: 60_000, maxTrackedClients: 2, now: c.now });
+
+  limiter.check("a"); // oldest window
+  c.advance(1_000);
+  limiter.check("b");
+
+  // `a`'s window elapses and it comes back. That reset must move it behind `b`,
+  // or the next insert evicts the client that just renewed instead of the stale
+  // one -- the invariant #evictOldest depends on.
+  c.advance(60_000);
+  assert.equal(limiter.check("a").allowed, true);
+
+  limiter.check("c"); // evicts one entry; it must be `b`, not the renewed `a`
+  assert.equal(limiter.size, 2);
+  assert.equal(limiter.check("a").allowed, false); // still tracked, still spent
+  assert.equal(limiter.check("b").allowed, true); // evicted, so its count is gone
+});
+
+test("a client rotating its id cannot grow the map past the cap", () => {
+  const c = clock();
+  const limiter = new RateLimiter({ limit: 1, windowMs: 60_000, maxTrackedClients: 4, now: c.now });
+  for (let i = 0; i < 500; i++) limiter.check(`flood-${i}`);
+  assert.equal(limiter.size, 4);
+});
