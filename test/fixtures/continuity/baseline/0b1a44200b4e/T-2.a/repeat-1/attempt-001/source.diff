diff --git a/src/jobs/JobQueue.test.ts b/src/jobs/JobQueue.test.ts
new file mode 100644
index 0000000..58fe0ee
--- /dev/null
+++ b/src/jobs/JobQueue.test.ts
@@ -0,0 +1,191 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { JobQueue } from "./JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+/** A queue whose lines are captured rather than written to stdout. */
+function queueWithCapture(): { queue: JobQueue; lines: LogLine[] } {
+  const lines: LogLine[] = [];
+  return { queue: new JobQueue((l) => lines.push(l)), lines };
+}
+
+test("a job that succeeds logs start and success under the request id it was enqueued under", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "report", payload: { n: 1 } }, { requestId: "req-enqueued" });
+
+  const counts = await queue.run(() => {});
+
+  assert.deepEqual(counts, { ran: 1, failed: 0 });
+  assert.deepEqual(
+    lines.map((l) => l.message),
+    ["job started", "job succeeded"],
+  );
+  for (const line of lines) assert.equal(line.requestId, "req-enqueued");
+  assert.deepEqual(lines[0].fields, { jobId: "job-1", kind: "report" });
+  assert.equal(lines[1].fields.jobId, "job-1");
+  assert.equal(typeof lines[1].fields.durationMs, "number");
+});
+
+test("jobs enqueued under different request ids each log under their own", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "a", payload: null }, { requestId: "req-one" });
+  queue.enqueue({ kind: "b", payload: null }, { requestId: "req-two" });
+
+  await queue.run(() => {});
+
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.fields.jobId]),
+    [
+      ["req-one", "job-1"],
+      ["req-one", "job-1"],
+      ["req-two", "job-2"],
+      ["req-two", "job-2"],
+    ],
+  );
+});
+
+test("the logger handed to the runner is bound to the enqueuing request id and the queue's sink", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-runner" });
+
+  // Assertions go outside the runner: run() catches whatever the runner throws, so a failed
+  // assertion in there would be swallowed into a "job failed" line instead of failing the test.
+  let seenByRunner: string | undefined;
+  const counts = await queue.run((job, log) => {
+    seenByRunner = log.requestId;
+    log.info("halfway through", { jobId: job.id });
+  });
+
+  assert.deepEqual(counts, { ran: 1, failed: 0 }, "the runner completed rather than throwing");
+  assert.equal(seenByRunner, "req-runner", "the logger handed in was bound to the enqueuing id");
+  const own = lines.find((l) => l.message === "halfway through");
+  assert.ok(own, "the runner's own line reached the queue's sink");
+  assert.equal(own.requestId, "req-runner");
+});
+
+test("a failing job is logged and dropped, and the rest of the batch still runs", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "boom", payload: null }, { requestId: "req-fail" });
+  queue.enqueue({ kind: "fine", payload: null }, { requestId: "req-ok" });
+  const ranKinds: string[] = [];
+
+  const counts = await queue.run((job) => {
+    if (job.kind === "boom") throw new Error("runner exploded");
+    ranKinds.push(job.kind);
+  });
+
+  assert.deepEqual(counts, { ran: 1, failed: 1 });
+  assert.deepEqual(ranKinds, ["fine"], "the job after the failure still ran");
+  const failure = lines.find((l) => l.message === "job failed");
+  assert.ok(failure);
+  assert.equal(failure.level, "error");
+  assert.equal(failure.requestId, "req-fail");
+  assert.equal(failure.fields.error, "runner exploded");
+  assert.equal(queue.size, 0);
+});
+
+test("a failing job still logs its start before its failure", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "boom", payload: null }, { requestId: "req-order" });
+
+  await queue.run(() => {
+    throw new Error("runner exploded");
+  });
+
+  assert.deepEqual(
+    lines.map((l) => l.message),
+    ["job started", "job failed"],
+  );
+});
+
+test("a secret in a thrown error message is redacted before the line is written", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-secret" });
+
+  await queue.run(() => {
+    throw new Error("upstream refused Bearer abc");
+  });
+
+  const failure = lines.find((l) => l.message === "job failed");
+  assert.ok(failure);
+  assert.equal(failure.fields.error, "upstream refused [REDACTED]");
+});
+
+test("a non-Error throw still produces a string error field", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-nonerror" });
+
+  const counts = await queue.run(() => {
+    throw "boom";
+  });
+
+  assert.deepEqual(counts, { ran: 0, failed: 1 });
+  const failure = lines.find((l) => l.message === "job failed");
+  assert.ok(failure);
+  assert.equal(failure.fields.error, "boom");
+});
+
+test("the payload never reaches a log line", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue(
+    { kind: "report", payload: { password: "hunter2", token: "sk-abcdefghijk" } },
+    { requestId: "req-payload" },
+  );
+
+  await queue.run(() => {});
+
+  assert.equal(lines.length, 2);
+  for (const line of lines) {
+    assert.ok(!("payload" in line.fields), "no payload field is emitted");
+    assert.ok(!JSON.stringify(line).includes("hunter2"), "no payload value leaks into the line");
+  }
+});
+
+test("the payload never reaches the failure line either", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue(
+    { kind: "report", payload: { password: "hunter2", token: "sk-abcdefghijk" } },
+    { requestId: "req-payload-fail" },
+  );
+
+  await queue.run(() => {
+    throw new Error("runner exploded");
+  });
+
+  const failure = lines.find((l) => l.message === "job failed");
+  assert.ok(failure);
+  assert.ok(!("payload" in failure.fields), "no payload field is emitted on failure");
+  assert.ok(!JSON.stringify(failure).includes("hunter2"), "no payload value leaks into the failure line");
+  assert.equal(typeof failure.fields.durationMs, "number");
+});
+
+test("a sink that throws cannot turn a successful job into a failed one", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => {
+    if (l.message === "job succeeded") throw new Error("sink is broken");
+    lines.push(l);
+  });
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-sink" });
+
+  // The broken sink surfaces rather than being swallowed, and crucially the job is never
+  // reported as failed: the runner succeeded, and only the sink did not.
+  await assert.rejects(queue.run(() => {}), /sink is broken/);
+  assert.equal(
+    lines.find((l) => l.message === "job failed"),
+    undefined,
+    "a sink failure is not logged as a job failure",
+  );
+});
+
+test("enqueue refuses a blank request id, and the jobs it did accept still run", async () => {
+  const { queue, lines } = queueWithCapture();
+  queue.enqueue({ kind: "fine", payload: null }, { requestId: "req-good" });
+
+  assert.throws(() => queue.enqueue({ kind: "bad", payload: null }, { requestId: "" }), /non-empty request id/);
+  assert.throws(() => queue.enqueue({ kind: "bad", payload: null }, { requestId: "   " }), /non-empty request id/);
+
+  assert.equal(queue.size, 1, "the refused jobs were never queued");
+  const counts = await queue.run(() => {});
+  assert.deepEqual(counts, { ran: 1, failed: 0 });
+  for (const line of lines) assert.equal(line.requestId, "req-good");
+});
diff --git a/src/jobs/JobQueue.ts b/src/jobs/JobQueue.ts
index 807e78b..c78fc25 100644
--- a/src/jobs/JobQueue.ts
+++ b/src/jobs/JobQueue.ts
@@ -1,7 +1,10 @@
 /**
  * Background jobs. A job records the request id of the request that enqueued
- * it. Running a job does not log anything yet.
+ * it, and everything logged while that job runs -- by the queue and by the
+ * runner alike -- goes out under that same id.
  */
+import { AppLogger, type Sink } from "../platform/logging/AppLogger.ts";
+
 export interface Job {
   readonly kind: string;
   readonly payload: unknown;
@@ -13,13 +16,25 @@ export interface QueuedJob extends Job {
   readonly enqueuedAt: number;
 }
 
-export type JobRunner = (job: QueuedJob) => Promise<void> | void;
+/** The logger is handed in already bound to the job's enqueuing request id, so a runner never mints its own. */
+export type JobRunner = (job: QueuedJob, log: AppLogger) => Promise<void> | void;
 
 export class JobQueue {
   readonly #jobs: QueuedJob[] = [];
+  readonly #sink: Sink | undefined;
   #next = 1;
 
+  /** A sink can be supplied so a test can observe what jobs log; production uses AppLogger's default. */
+  constructor(sink?: Sink) {
+    this.#sink = sink;
+  }
+
+  /**
+   * A job with no usable request id is refused here rather than at run time: this is the last point
+   * where the caller still has the request context that would explain it.
+   */
   enqueue(job: Job, opts: { requestId: string }): string {
+    if (opts.requestId.trim() === "") throw new Error("JobQueue requires a non-empty request id");
     const id = `job-${this.#next++}`;
     this.#jobs.push({ ...job, id, requestId: opts.requestId, enqueuedAt: Date.now() });
     return id;
@@ -29,17 +44,31 @@ export class JobQueue {
     return this.#jobs.length;
   }
 
-  /** Runs every queued job in order. A failing job is dropped; the rest still run. */
+  /** Runs every queued job in order, logging its start and outcome. A failing job is dropped; the rest still run. */
   async run(runner: JobRunner): Promise<{ ran: number; failed: number }> {
     let ran = 0;
     let failed = 0;
     while (this.#jobs.length > 0) {
       const job = this.#jobs.shift()!;
+      // One logger per job: jobs in the same queue carry different request ids, and each line must carry its own.
+      const log = AppLogger.withRequestId(job.requestId, this.#sink);
+      const startedAt = Date.now();
+      log.info("job started", { jobId: job.id, kind: job.kind });
