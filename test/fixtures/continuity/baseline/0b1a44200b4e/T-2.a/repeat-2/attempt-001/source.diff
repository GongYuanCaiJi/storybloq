diff --git a/src/jobs/JobQueue.test.ts b/src/jobs/JobQueue.test.ts
new file mode 100644
index 0000000..34093d3
--- /dev/null
+++ b/src/jobs/JobQueue.test.ts
@@ -0,0 +1,109 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { JobQueue } from "./JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+/** The message/requestId/level spine of the emitted lines, which is what the ordering assertions are about. */
+function spine(lines: LogLine[]): Array<Pick<LogLine, "requestId" | "level" | "message">> {
+  return lines.map(({ requestId, level, message }) => ({ requestId, level, message }));
+}
+
+test("a job's start and success are logged under the request id that enqueued it", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  const id = queue.enqueue({ kind: "report", payload: { secretish: "hunter2" } }, { requestId: "req-job-1" });
+
+  assert.deepEqual(await queue.run(() => {}), { ran: 1, failed: 0 });
+  assert.deepEqual(spine(lines), [
+    { requestId: "req-job-1", level: "info", message: "job started" },
+    { requestId: "req-job-1", level: "info", message: "job succeeded" },
+  ]);
+  // Closed field set: it is what pins "payload is not logged". redact() would not catch a secret
+  // under a neutral key inside a caller-supplied payload.
+  for (const line of lines) assert.deepEqual(line.fields, { jobId: id, kind: "report" });
+});
+
+test("a failing job logs a failure under its own request id, and the rest still run", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-job-a" });
+  queue.enqueue({ kind: "digest", payload: null }, { requestId: "req-job-b" });
+
+  const result = await queue.run((job) => {
+    if (job.requestId === "req-job-a") throw new Error("upstream refused");
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  // The full sequence, not an existence check: a `finally`-emitted success line would add a fifth
+  // line under req-job-a, and the differing ids catch a queue-level or per-run() logger.
+  assert.deepEqual(spine(lines), [
+    { requestId: "req-job-a", level: "info", message: "job started" },
+    { requestId: "req-job-a", level: "error", message: "job failed" },
+    { requestId: "req-job-b", level: "info", message: "job started" },
+    { requestId: "req-job-b", level: "info", message: "job succeeded" },
+  ]);
+  assert.deepEqual(lines[1].fields, { jobId: "job-1", kind: "report", error: "upstream refused" });
+});
+
+test("a secret in a job failure is redacted before the line is written", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-job-2" });
+
+  await queue.run(() => {
+    throw new Error("upstream refused Bearer abc-secret for job");
+  });
+
+  const failure = lines.find((l) => l.message === "job failed");
+  assert.ok(failure, "expected a job failed line");
+  assert.equal(failure?.fields.error, "upstream refused [REDACTED] for job");
+});
+
+test("a job cannot be enqueued without a request id", () => {
+  const queue = new JobQueue(() => {});
+  assert.throws(() => queue.enqueue({ kind: "report", payload: null }, { requestId: "  " }), /non-empty request id/);
+  assert.equal(queue.size, 0);
+});
+
+test("an async runner that rejects is awaited, logged as failed, and does not stall the drain", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-job-4" });
+  queue.enqueue({ kind: "digest", payload: null }, { requestId: "req-job-5" });
+
+  // Without the `await` in run(), the rejection escapes as an unhandled rejection and the job is
+  // counted as ran and logged as succeeded -- exactly what this ticket exists to make visible.
+  // Every other test uses a synchronous runner, so this is the only one that pins the await.
+  const result = await queue.run(async (job) => {
+    if (job.requestId === "req-job-4") throw new Error("async upstream refused");
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  assert.deepEqual(spine(lines), [
+    { requestId: "req-job-4", level: "info", message: "job started" },
+    { requestId: "req-job-4", level: "error", message: "job failed" },
+    { requestId: "req-job-5", level: "info", message: "job started" },
+    { requestId: "req-job-5", level: "info", message: "job succeeded" },
+  ]);
+  assert.equal(lines[1].fields.error, "async upstream refused");
+});
+
+test("the runner is handed a logger already bound to the job's request id", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-job-3" });
+
+  // run() swallows whatever the runner throws, so the assertions that matter are the outer ones:
+  // a wrong id in here would otherwise be converted into a "job failed" line and pass unnoticed.
+  const result = await queue.run((job, log) => {
+    assert.equal(log.requestId, job.requestId);
+    log.info("runner line");
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 0 });
+  assert.deepEqual(spine(lines), [
+    { requestId: "req-job-3", level: "info", message: "job started" },
+    { requestId: "req-job-3", level: "info", message: "runner line" },
+    { requestId: "req-job-3", level: "info", message: "job succeeded" },
+  ]);
+});
