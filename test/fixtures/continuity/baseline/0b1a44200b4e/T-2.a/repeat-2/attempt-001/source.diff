+  "createdBy": "T-2 autonomous session (IMPLEMENT verification)",
+  "dedupeKey": "t-2-implement:no-types-node-typecheck-broken",
+  "discoveredDate": "2026-09-21",
+  "id": "ISS-002",
+  "impact": "`tsc --noEmit -p tsconfig.json` reports TS2307 \"Cannot find module 'node:test' / 'node:assert/strict' / 'node:crypto'\" and TS2580 \"Cannot find name 'process'\" on pristine HEAD, across src/http/handler.ts, src/http/router.test.ts, src/platform/logging/AppLogger.ts and AppLogger.test.ts. The cause is that no @types/node is installed (there is no node_modules and package.json declares no devDependencies). Consequence: tsconfig.json sets `strict: true` and `noEmit: true`, but nothing can actually typecheck the project, and `npm test` is `node --test`, which strips types without checking them. A genuine type error therefore reaches main unnoticed - one did surface during T-2 (TS18048 in a new test, masked among the resolution noise). Resolving this is an owner call, because the obvious fix (`npm i --save-dev @types/node`) sits against RULES.md #2 \"Keep the code dependency-free: Node built-ins only\" - whether that rule is about runtime dependencies only, or about devDependencies too, is not settled anywhere in the repo. Found during T-2 implementation verification; pre-existing and out of scope for T-2.",
+  "location": [
+    "tsconfig.json",
+    "package.json"
+  ],
+  "phase": "p1",
+  "relatedTickets": [
+    "T-2"
+  ],
+  "resolution": null,
+  "resolvedDate": null,
+  "severity": "low",
+  "status": "open",
+  "title": "Project cannot be typechecked: no @types/node, so tsc --noEmit fails on every file using a Node built-in"
+}
