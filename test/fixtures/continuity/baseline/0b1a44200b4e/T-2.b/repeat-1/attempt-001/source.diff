new file mode 100644
index 0000000..32270fc
--- /dev/null
+++ b/src/http/handler.test.ts
@@ -0,0 +1,77 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { createApp } from "./handler.ts";
+import { JobQueue } from "../jobs/JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("a job logs under the request id the HTTP layer assigned, not a fresh one", async () => {
+  const lines: LogLine[] = [];
+  const sink = (l: LogLine) => lines.push(l);
+  const queue = new JobQueue(sink);
+  const app = createApp(queue, sink);
+
+  const res = await app.handle({
+    method: "POST",
+    path: "/reports",
+    headers: { "x-request-id": "req-http-1" },
+    body: { kind: "daily" },
+  });
+  assert.equal(res.status, 202);
+
+  await queue.run(() => {});
+
+  // The whole chain: id assigned in handle(), carried through enqueue(), emitted by run().
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.message]),
+    [
+      ["req-http-1", "report queued"],
+      ["req-http-1", "job started"],
+      ["req-http-1", "job succeeded"],
+    ],
+  );
+});
+
+test("a caller-supplied queue keeps its own sink; the router uses createApp's", async () => {
+  const queueLines: LogLine[] = [];
+  const routerLines: LogLine[] = [];
+  const queue = new JobQueue((l) => queueLines.push(l));
+  const app = createApp(queue, (l) => routerLines.push(l));
+
+  await app.handle({
+    method: "POST",
+    path: "/reports",
+    headers: { "x-request-id": "req-http-3" },
+    body: { kind: "daily" },
+  });
+  await queue.run(() => {});
+
+  // The documented contract: createApp does not rebind a queue the caller built.
+  assert.deepEqual(routerLines.map((l) => l.message), ["report queued"]);
+  assert.deepEqual(queueLines.map((l) => l.message), ["job started", "job succeeded"]);
+});
+
+test("the default queue is built with the sink the caller supplied", async () => {
+  const lines: LogLine[] = [];
+  const app = createApp(undefined, (l) => lines.push(l));
+
+  const res = await app.handle({
+    method: "POST",
+    path: "/reports",
+    headers: { "x-request-id": "req-http-2" },
+    body: { kind: "daily" },
+  });
+  assert.equal(res.status, 202);
+
+  // Draining is the whole point: the route line comes from the Router, which was already
+  // wired to the sink. Only the job lines can show that the DEFAULT queue got it too.
+  await app.jobs.run(() => {});
+
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.message]),
+    [
+      ["req-http-2", "report queued"],
+      ["req-http-2", "job started"],
+      ["req-http-2", "job succeeded"],
+    ],
+  );
+});
