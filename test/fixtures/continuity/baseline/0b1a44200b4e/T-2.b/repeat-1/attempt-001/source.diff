diff --git a/src/jobs/JobQueue.test.ts b/src/jobs/JobQueue.test.ts
new file mode 100644
index 0000000..88a3f58
--- /dev/null
+++ b/src/jobs/JobQueue.test.ts
@@ -0,0 +1,116 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { JobQueue } from "./JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("start, success and failure are all logged, each under its own enqueuing request id", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-a" });
+  queue.enqueue({ kind: "email", payload: null }, { requestId: "req-b" });
+
+  const result = await queue.run((job) => {
+    if (job.kind === "email") throw new Error("smtp refused");
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  assert.equal(lines.length, 4);
+  // The two jobs came from different requests: a per-queue logger would stamp one id on all four.
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.message, l.level]),
+    [
+      ["req-a", "job started", "info"],
+      ["req-a", "job succeeded", "info"],
+      ["req-b", "job started", "info"],
+      ["req-b", "job failed", "error"],
+    ],
+  );
+  assert.deepEqual(lines[3].fields, { jobId: "job-2", kind: "email", error: "smtp refused" });
+});
+
+test("a failing job does not stop the drain, and the return value is unchanged", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  for (const kind of ["first", "boom", "third"]) queue.enqueue({ kind, payload: null }, { requestId: "req-1" });
+
+  const result = await queue.run((job) => {
+    if (job.kind === "boom") throw new Error("nope");
+  });
+
+  assert.deepEqual(result, { ran: 2, failed: 1 });
+  assert.equal(queue.size, 0);
+  // The job after the failure still ran and still logged.
+  assert.deepEqual(
+    lines.filter((l) => l.fields.kind === "third").map((l) => l.message),
+    ["job started", "job succeeded"],
+  );
+});
+
+test("a secret in a job's failure is redacted before the line is written", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-1" });
+
+  await queue.run(() => {
+    throw new Error("upstream refused Bearer abc");
+  });
+
+  const failure = lines.find((l) => l.message === "job failed")!;
+  assert.equal(failure.fields.error, "upstream refused [REDACTED]");
+  assert.doesNotMatch(JSON.stringify(failure), /Bearer abc/);
+});
+
+test("a job that throws a non-Error still logs and still leaves the drain intact", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "bare", payload: null }, { requestId: "req-1" });
+  queue.enqueue({ kind: "text", payload: null }, { requestId: "req-1" });
+  queue.enqueue({ kind: "after", payload: null }, { requestId: "req-1" });
+
+  const result = await queue.run((job) => {
+    // String() throws on a null-prototype object; if that escaped, the drain would stop here.
+    if (job.kind === "bare") throw Object.create(null);
+    if (job.kind === "text") throw "just a string";
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 2 });
+  const failures = lines.filter((l) => l.message === "job failed");
+  assert.deepEqual(failures.map((l) => l.fields.error), ["unknown error", "just a string"]);
+  // The job queued after both failures still ran.
+  assert.ok(lines.some((l) => l.message === "job succeeded" && l.fields.kind === "after"));
+});
+
+test("a sink fault on the success line surfaces instead of being relabelled a job failure", async () => {
+  const seen: string[] = [];
+  const queue = new JobQueue((l) => {
+    seen.push(l.message);
+    // Stands in for a real sink fault, e.g. EPIPE on a closed stdout.
+    if (l.message === "job succeeded") throw new Error("sink is gone");
+  });
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-1" });
+
+  // The sink fault surfaces rather than being silently absorbed as a job failure...
+  await assert.rejects(queue.run(() => {}), /sink is gone/);
+  // ...and the job is never relabelled a failure: no "job failed" line was written for it.
+  assert.deepEqual(seen, ["job started", "job succeeded"]);
+});
+
+test("a blank request id is refused at enqueue, consuming nothing", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "first", payload: null }, { requestId: "req-1" });
+
+  assert.throws(() => queue.enqueue({ kind: "bad", payload: null }, { requestId: "  " }), /non-empty request id/);
+  // An untyped caller gets the same diagnostic, not an opaque property-access TypeError.
+  assert.throws(
+    () => queue.enqueue({ kind: "bad", payload: null }, { requestId: null as unknown as string }),
+    /non-empty request id/,
+  );
+  assert.equal(queue.size, 1);
+  // The rejected call must not have burned job-2: that is what pins the guard ahead of the id allocation.
+  assert.equal(queue.enqueue({ kind: "second", payload: null }, { requestId: "req-2" }), "job-2");
+
+  // The drain is intact: the bad job never reached it, so run() does not throw part-way through.
+  assert.deepEqual(await queue.run(() => {}), { ran: 2, failed: 0 });
+  assert.deepEqual(lines.map((l) => l.requestId), ["req-1", "req-1", "req-2", "req-2"]);
+});
