diff --git a/src/jobs/JobQueue.test.ts b/src/jobs/JobQueue.test.ts
new file mode 100644
index 0000000..0c93fb2
--- /dev/null
+++ b/src/jobs/JobQueue.test.ts
@@ -0,0 +1,149 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { JobQueue } from "./JobQueue.ts";
+import type { LogLine } from "../platform/logging/AppLogger.ts";
+
+test("a job that succeeds logs its start and its success under the enqueuing request id", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: { n: 1 } }, { requestId: "req-1" });
+
+  const result = await queue.run(() => {});
+
+  assert.deepEqual(result, { ran: 1, failed: 0 });
+  assert.deepEqual(
+    lines.map((l) => [l.level, l.message, l.requestId]),
+    [
+      ["info", "job started", "req-1"],
+      ["info", "job succeeded", "req-1"],
+    ],
+  );
+  for (const line of lines) assert.deepEqual(line.fields, { jobId: "job-1", kind: "report" });
+});
+
+test("a failing job logs the failure and is dropped; the jobs behind it still run", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "bad", payload: null }, { requestId: "req-2" });
+  queue.enqueue({ kind: "good", payload: null }, { requestId: "req-3" });
+
+  const result = await queue.run((job) => {
+    if (job.kind === "bad") throw new Error("upstream refused");
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  assert.deepEqual(
+    lines.map((l) => [l.level, l.message]),
+    [
+      ["info", "job started"],
+      ["error", "job failed"],
+      ["info", "job started"],
+      ["info", "job succeeded"],
+    ],
+  );
+  assert.deepEqual(lines[1].fields, { jobId: "job-1", kind: "bad", error: "upstream refused" });
+});
+
+test("each job logs under its own enqueuing request id, never a fresh one", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "first", payload: null }, { requestId: "req-a" });
+  queue.enqueue({ kind: "second", payload: null }, { requestId: "req-b" });
+
+  await queue.run(() => {});
+
+  assert.deepEqual(
+    lines.map((l) => l.requestId),
+    ["req-a", "req-a", "req-b", "req-b"],
+  );
+});
+
+test("a secret in a job failure never reaches the log line unredacted", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "report", payload: null }, { requestId: "req-4" });
+
+  await queue.run(() => {
+    throw new Error("upstream refused Bearer abc123");
+  });
+
+  const failures = lines.filter((l) => l.level === "error");
+  assert.equal(failures.length, 1);
+  assert.equal(failures[0].fields.error, "upstream refused [REDACTED]");
+});
+
+test("a job whose request id is unusable still runs, is still counted, and logs nothing", async () => {
+  const lines: LogLine[] = [];
+  const ranKinds: string[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "blank-id", payload: null }, { requestId: "" });
+  queue.enqueue({ kind: "after", payload: null }, { requestId: "req-5" });
+
+  const result = await queue.run((job) => {
+    ranKinds.push(job.kind);
+  });
+
+  // The job's work happened and was counted; only its log lines are missing, because no
+  // compliant line can be written without a request id.
+  assert.deepEqual(ranKinds, ["blank-id", "after"]);
+  assert.deepEqual(result, { ran: 2, failed: 0 });
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.message]),
+    [
+      ["req-5", "job started"],
+      ["req-5", "job succeeded"],
+    ],
+  );
+});
+
+test("a sink that throws does not change whether a job ran or how it was counted", async () => {
+  const queue = new JobQueue(() => {
+    throw new Error("sink is broken");
+  });
+  queue.enqueue({ kind: "good", payload: null }, { requestId: "req-6" });
+  queue.enqueue({ kind: "bad", payload: null }, { requestId: "req-7" });
+
+  const result = await queue.run((job) => {
+    if (job.kind === "bad") throw new Error("runner failed");
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+});
+
+test("a runner that returns a rejected promise is a counted failure", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "async", payload: null }, { requestId: "req-8" });
+
+  const result = await queue.run(async () => {
+    await Promise.resolve();
+    throw new Error("async failure");
+  });
+
+  assert.deepEqual(result, { ran: 0, failed: 1 });
+  assert.deepEqual(lines[1].fields, { jobId: "job-1", kind: "async", error: "async failure" });
+});
+
+test("a thrown value that cannot be stringified is still logged as a failure, and the queue drains", async () => {
+  const lines: LogLine[] = [];
+  const queue = new JobQueue((l) => lines.push(l));
+  queue.enqueue({ kind: "unstringifiable", payload: null }, { requestId: "req-9" });
+  queue.enqueue({ kind: "after", payload: null }, { requestId: "req-10" });
+
+  const result = await queue.run((job) => {
+    if (job.kind === "unstringifiable") throw Object.create(null);
+  });
+
+  assert.deepEqual(result, { ran: 1, failed: 1 });
+  assert.deepEqual(
+    lines.map((l) => [l.requestId, l.message]),
+    [
+      ["req-9", "job started"],
+      ["req-9", "job failed"],
+      ["req-10", "job started"],
+      ["req-10", "job succeeded"],
+    ],
+  );
+  // The value could not be described, but the failure is still visible under its own id.
+  assert.deepEqual(lines[1].fields, { jobId: "job-1", kind: "unstringifiable", error: "unstringifiable object" });
+});
diff --git a/src/jobs/JobQueue.ts b/src/jobs/JobQueue.ts
index 807e78b..1adc48b 100644
--- a/src/jobs/JobQueue.ts
+++ b/src/jobs/JobQueue.ts
@@ -1,7 +1,10 @@
 /**
  * Background jobs. A job records the request id of the request that enqueued
- * it. Running a job does not log anything yet.
+ * it, and everything a job logs while it runs goes through AppLogger under that
+ * same id -- never a fresh one (ruling r-p19bbvh0jhj8xgma).
  */
+import { AppLogger, type LogLevel, type Sink } from "../platform/logging/AppLogger.ts";
+
 export interface Job {
   readonly kind: string;
   readonly payload: unknown;
@@ -17,8 +20,14 @@ export type JobRunner = (job: QueuedJob) => Promise<void> | void;
 
 export class JobQueue {
   readonly #jobs: QueuedJob[] = [];
+  readonly #sink: Sink | undefined;
   #next = 1;
 
+  /** A sink can be supplied so a test can observe what jobs log; production uses AppLogger's default. */
+  constructor(sink?: Sink) {
+    this.#sink = sink;
+  }
+
   enqueue(job: Job, opts: { requestId: string }): string {
     const id = `job-${this.#next++}`;
     this.#jobs.push({ ...job, id, requestId: opts.requestId, enqueuedAt: Date.now() });
@@ -29,19 +38,57 @@ export class JobQueue {
     return this.#jobs.length;
   }
 
-  /** Runs every queued job in order. A failing job is dropped; the rest still run. */
+  /**
+   * Runs every queued job in order, logging each job's start, success and failure under the
+   * request id that enqueued it. A failing job is dropped; the rest still run.
+   *
+   * Only the runner sits inside the try: logging is additive and never decides whether a job
+   * ran or how it was counted.
+   */
   async run(runner: JobRunner): Promise<{ ran: number; failed: number }> {
     let ran = 0;
     let failed = 0;
     while (this.#jobs.length > 0) {
       const job = this.#jobs.shift()!;
+      this.#emit(job, "info", "job started");
       try {
         await runner(job);
         ran++;
-      } catch {
+        this.#emit(job, "info", "job succeeded");
+      } catch (err) {
         failed++;
+        this.#emit(job, "error", "job failed", { err });
       }
     }
     return { ran, failed };
   }
+
+  /**
+   * The only place this class writes a line. Everything that can throw happens inside the
+   * try, so no logging fault can reach the caller and abandon the jobs still queued.
+   */
+  #emit(job: QueuedJob, level: LogLevel, message: string, cause?: { readonly err: unknown }): void {
+    try {
+      const fields: Record<string, unknown> = { jobId: job.id, kind: job.kind };
+      if (cause) fields.error = describeError(cause.err);
+      AppLogger.withRequestId(job.requestId, this.#sink)[level](message, fields);
+    } catch {
+      // A logging fault never changes a job's outcome. An unusable request id cannot produce
+      // a compliant line at all (r-eftp2zdb6as643np), so the line is dropped rather than
+      // written without one.
+    }
+  }
+}
+
+/**
+ * A thrown value need not be describable: `String(Object.create(null))` throws, and so can a
+ * `message` getter. The failure still has to be visible, so an undescribable value degrades to
+ * its type rather than costing the whole line.
+ */
+function describeError(err: unknown): string {
+  try {
+    return err instanceof Error ? err.message : String(err);
+  } catch {
+    return `unstringifiable ${typeof err}`;
+  }
 }