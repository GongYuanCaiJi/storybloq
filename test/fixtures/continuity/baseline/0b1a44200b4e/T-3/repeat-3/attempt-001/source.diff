+  "dedupeKey": "t-3-code-review-1:packaging-followup",
+  "discoveredDate": "2026-09-21",
+  "id": "ISS-001",
+  "impact": "T-3 moved the logger to packages/logging/ and updated every import, which is all the ticket asked for, but the move alone does not deliver the ticket's stated motivation (\"the logger is about to be shared with a second service\"). packages/logging has no package.json and the repo has no workspace configuration, and the three importers reach it by deep relative path (\"../../packages/logging/AppLogger.ts\"). Deep relative escapes out of src/ do not port to another service or repo, so the second service cannot consume the logger as it stands. Needs a manifest and/or workspace entry (and a decision on the import specifier the consumers should use) before the second service lands. Deliberately out of scope for T-3: the approved plan excluded a manifest, since the repo has no workspaces today and the ticket did not ask for publishing.",
+  "location": [
+    "packages/logging/AppLogger.ts",
+    "package.json",
+    "src/http/router.ts"
+  ],
+  "phase": "p1",
+  "relatedTickets": [
+    "T-3"
+  ],
+  "resolution": null,
+  "resolvedDate": null,
+  "severity": "medium",
+  "status": "open",
+  "title": "packages/logging has no manifest, so a second service still cannot consume it"
+}
